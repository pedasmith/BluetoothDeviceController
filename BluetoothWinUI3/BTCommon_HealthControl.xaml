<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BluetoothWinUI3.BTCommon_HealthControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BluetoothWinUI3"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oxyplot="using:OxyPlot"
    xmlns:tv="using:WinUI.TableView"
    mc:Ignorable="d"
    >

    <Border Style="{StaticResource sDeviceBorder}" x:Name="rootPanel">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="uiKnownDeviceName" Grid.Row="0" Text="Health Sensor" Style="{StaticResource sDeviceTitle}"/>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <GridView Grid.Row="0" Style="{StaticResource sDeviceDataList}" ItemContainerStyle="{StaticResource sDeviceDataListItem}" x:Name="uiDeviceDataList">
                    <StackPanel Style="{StaticResource sDeviceDataPanel}" x:Name="uiDeviceDataPulseRate">
                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource sDevicePrimaryTitle}">
                        <Run>Pulse</Run><Run Text="&#160;"/><Run x:Name="uiPulseRateChange" Text="┄"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource sDevicePrimaryData}"><Run x:Name="uiPulseRate"/></TextBlock>
                        <Line Height="5" Tag="PulseRateColor" Style="{StaticResource sGraphLineKey}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource sDeviceDataPanel}" x:Name="uiDeviceDataOxygenSaturationInPercent">
                        <TextBlock Style="{StaticResource sDevicePrimaryTitle}">
                        <Run>Oxygen %</Run>
                        </TextBlock>
                        <TextBlock Style="{StaticResource sDevicePrimaryData}"><Run x:Name="uiOxygenSaturationInPercent"/></TextBlock>
                        <Line Height="5" Tag="OxygenSaturationInPercentColor" Style="{StaticResource sGraphLineKey}"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource sDeviceDataPanel}" x:Name="uiDeviceDataPerfusionIndexInPercent">
                        <TextBlock Style="{StaticResource sDevicePrimaryTitle}">
                        <Run>Perfusion %</Run>
                        </TextBlock>
                        <TextBlock Style="{StaticResource sDevicePrimaryData}"><Run x:Name="uiPerfusionIndexInPercent"/></TextBlock>
                        <Line Height="5" Tag="PerfusionIndexInPercentColor" Style="{StaticResource sGraphLineKey}" />
                    </StackPanel>
                </GridView>
                <oxyplot:PlotView Grid.Row="2" x:Name="uiOxyPlot" Background="Transparent" Visibility="Visible"  />
                <Grid Grid.Row="2" x:Name="uiDataGridPanel" Visibility="Collapsed" >
                    <tv:TableView x:Name="uiTableView" IsReadOnly="True" />
                </Grid>

            </Grid>
            <TextBlock Grid.Row="2" Style="{StaticResource sDeviceMinorText}"><Run>Bluetooth Address: </Run><Run x:Name="uiAddress"/></TextBlock>
            <local:BTConnectionControl Grid.Row="3" x:Name="uiBTConnectionControl" />
        </Grid>
    </Border>
</UserControl>
